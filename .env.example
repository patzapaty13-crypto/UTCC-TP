# =============================================================================
# UTCC-TP Backend — Environment variables (copy to .env, fill real values)
# =============================================================================

# --- Spring / runtime ---
SPRING_PROFILES_ACTIVE=supabase      # supabase | postgres | dev
PORT=8080

# --- Security ---
# REQUIRED in production. Generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=480

# --- CORS ---
# Comma-separated origins. Use wildcard only for local/dev.
CORS_ALLOWED_ORIGINS=https://utcc-tp.vercel.app,http://localhost:3000

# --- Database (Supabase Postgres) ---
# JDBC URL — include ?sslmode=require for Supabase
DATABASE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-me

# --- File storage ---
# auto = use Cloudinary when configured, otherwise local disk
STORAGE_PROVIDER=auto
STORAGE_ROOT=uploads

# --- Cloudinary (preferred for prod) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# OR for signed uploads (more secure, preferred for server-side uploads):
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
MAIL_FROM=UTCC-TP <onboarding@resend.dev>

# --- AI ---
AI_PROVIDER=openai                   # mock | openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- n8n Webhooks ---
# Base URL for all n8n webhooks
N8N_WEBHOOK_URL=https://thanathorn123.app.n8n.cloud/webhook/otp-send
N8N_WEBHOOK_BASE=https://thanathorn123.app.n8n.cloud/webhook
# Application Status Pipeline
N8N_WEBHOOK_APP_STATUS=https://thanathorn123.app.n8n.cloud/webhook/utcctp-app-status
# AI Resume Screening
N8N_WEBHOOK_RESUME=https://thanathorn123.app.n8n.cloud/webhook/utcctp-resume-screening
# Interview Auto-Scheduling
N8N_WEBHOOK_INTERVIEW=https://thanathorn123.app.n8n.cloud/webhook/utcctp-interview-scheduled
# Security Alert
N8N_WEBHOOK_SECURITY=https://thanathorn123.app.n8n.cloud/webhook/security-alert
# Forgot Password
N8N_WEBHOOK_FORGOT_PW=https://thanathorn123.app.n8n.cloud/webhook/forgot-password
# Event Router
N8N_WEBHOOK_EVENTS=https://thanathorn123.app.n8n.cloud/webhook/utcctp-events

# --- Upload limits ---
MAX_UPLOAD_SIZE=20MB
MAX_REQUEST_SIZE=25MB
