# Frontend (Next.js) — Vercel environment variables
# =================================================
# URL of the Spring Boot backend API, including /api/v1 prefix.
# In production, point this at your Render backend.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Nexus AI (Google Gemini) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- OpenRouter (fallback AI model) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-max
